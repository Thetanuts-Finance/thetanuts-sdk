{
  "name": "@thetanuts-finance/mcp",
  "version": "0.1.0",
  "description": "MCP server for the Thetanuts SDK — read-only LLM tool access for options trading on Base + Ethereum",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "thetanuts-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "tsx scripts/embed-sdk-context.ts",
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsx scripts/embed-sdk-context.ts && tsx src/index.ts",
    "prepublishOnly": "node scripts/swap-sdk-dep.cjs && npm run build",
    "postpublish": "node scripts/restore-sdk-dep.cjs"
  },
  "keywords": [
    "thetanuts",
    "mcp",
    "model-context-protocol",
    "options",
    "defi",
    "ethereum",
    "base",
    "sdk",
    "claude",
    "anthropic",
    "llm"
  ],
  "author": "Thetanuts Finance",
  "license": "MIT",
  "homepage": "https://github.com/Thetanuts-Finance/thetanuts-sdk/tree/main/mcp-server",
  "repository": {
    "type": "git",
    "url": "https://github.com/Thetanuts-Finance/thetanuts-sdk.git",
    "directory": "mcp-server"
  },
  "bugs": {
    "url": "https://github.com/Thetanuts-Finance/thetanuts-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@thetanuts-finance/thetanuts-client": "file:..",
    "ethers": "^6.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
