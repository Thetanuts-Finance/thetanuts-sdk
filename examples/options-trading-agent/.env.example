# Coinbase Developer Platform — agent's MPC-managed wallet.
# Get these at https://portal.cdp.coinbase.com → API Keys.
# CDP API v2 (current). The legacy CDP_API_KEY_NAME / CDP_API_KEY_PRIVATE_KEY
# from older AgentKit examples no longer apply.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# Anthropic API key for the LLM. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=

# Base mainnet RPC. The public endpoint works for low volume; supply
# Alchemy/QuickNode/Infura for anything sustained.
BASE_RPC_URL=https://mainnet.base.org

# Set to "true" to skip every wallet.sendTransaction. The LLM still runs
# through the full plan but no chain writes happen — useful for the first
# run while you observe what it would do.
DRY_RUN=false
